# Copy to .env and adjust. Every setting can also be set as an env var (prefix SRE_).

# --- LLM provider: "ollama" (local, free) or "azure_openai" (Phase 7) ---
SRE_LLM_PROVIDER=ollama
SRE_CHAT_MODEL=qwen2.5:7b
SRE_EMBEDDING_MODEL=nomic-embed-text
# Must match the embedding model's output size; nomic-embed-text = 768, text-embedding-3-small = 1536
SRE_EMBEDDING_DIM=768
SRE_OLLAMA_BASE_URL=http://localhost:11434
SRE_TEMPERATURE=0.0

# --- Azure OpenAI (Phase 7) ---
# SRE_AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# SRE_AZURE_OPENAI_API_VERSION=2024-10-21
# SRE_AZURE_OPENAI_API_KEY=   # prefer Managed Identity in Azure; key only for local dev

# --- Vector store (infra/compose.yaml) ---
SRE_DATABASE_URL=postgresql://sre:<VECTORDB_PASSWORD from infra/.env>@localhost:5433/sre

# --- RAG tuning (defaults shown; see docs/learning/02-hybrid-rag.md) ---
# SRE_CHILD_MAX_TOKENS=128
# SRE_PARENT_MAX_TOKENS=1500
# SRE_CANDIDATE_K=20
# SRE_RRF_K=60
# SRE_TOP_PARENTS=3
# SRE_RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2   # set empty to disable reranking
# SRE_RERANK_CANDIDATES=30
# SRE_KEYWORD_MAX_DF=0.25

# --- Cost control: hard cap on estimated paid LLM spend (ledger in .audit/spend.jsonl) ---
# SRE_SPEND_LIMIT_USD=1.50
